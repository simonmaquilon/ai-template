{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$r/.scripts/check-staging.mjs\" ] || exit 0; node \"$r/.scripts/check-staging.mjs\" --hook",
            "commandWindows": "node -e \"const c=require('child_process'),p=require('path'),u=require('url');let r;try{r=c.execFileSync('git',['rev-parse','--show-toplevel'],{stdio:['ignore','pipe','ignore']}).toString().trim()}catch{process.exit(0)}import(u.pathToFileURL(p.join(r,'.scripts','check-staging.mjs')))\" -- --hook --powershell"
          },
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$r/.scripts/check-staging-effect.mjs\" ] || exit 0; node \"$r/.scripts/check-staging-effect.mjs\" --before",
            "commandWindows": "node -e \"const c=require('child_process'),p=require('path'),u=require('url');let r;try{r=c.execFileSync('git',['rev-parse','--show-toplevel'],{stdio:['ignore','pipe','ignore']}).toString().trim()}catch{process.exit(0)}import(u.pathToFileURL(p.join(r,'.scripts','check-staging-effect.mjs')))\" -- --before --powershell"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$r/.scripts/check-empty-dirs.mjs\" ] || exit 0; node \"$r/.scripts/check-empty-dirs.mjs\"",
            "commandWindows": "node -e \"const c=require('child_process'),p=require('path'),u=require('url');let r;try{r=c.execFileSync('git',['rev-parse','--show-toplevel'],{stdio:['ignore','pipe','ignore']}).toString().trim()}catch{process.exit(0)}import(u.pathToFileURL(p.join(r,'.scripts','check-empty-dirs.mjs')))\""
          },
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$r/.scripts/check-doc-links.mjs\" ] || exit 0; node \"$r/.scripts/check-doc-links.mjs\"",
            "commandWindows": "node -e \"const c=require('child_process'),p=require('path'),u=require('url');let r;try{r=c.execFileSync('git',['rev-parse','--show-toplevel'],{stdio:['ignore','pipe','ignore']}).toString().trim()}catch{process.exit(0)}import(u.pathToFileURL(p.join(r,'.scripts','check-doc-links.mjs')))\""
          },
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$r/.scripts/check-instructions.mjs\" ] || exit 0; node \"$r/.scripts/check-instructions.mjs\"",
            "commandWindows": "node -e \"const c=require('child_process'),p=require('path'),u=require('url');let r;try{r=c.execFileSync('git',['rev-parse','--show-toplevel'],{stdio:['ignore','pipe','ignore']}).toString().trim()}catch{process.exit(0)}import(u.pathToFileURL(p.join(r,'.scripts','check-instructions.mjs')))\""
          },
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$r/.scripts/check-symlinks.mjs\" ] || exit 0; node \"$r/.scripts/check-symlinks.mjs\"",
            "commandWindows": "node -e \"const c=require('child_process'),p=require('path'),u=require('url');let r;try{r=c.execFileSync('git',['rev-parse','--show-toplevel'],{stdio:['ignore','pipe','ignore']}).toString().trim()}catch{process.exit(0)}import(u.pathToFileURL(p.join(r,'.scripts','check-symlinks.mjs')))\""
          },
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$r/.scripts/check-file-length.mjs\" ] || exit 0; node \"$r/.scripts/check-file-length.mjs\" --hook --turn-start",
            "commandWindows": "node -e \"const c=require('child_process'),p=require('path'),u=require('url');let r;try{r=c.execFileSync('git',['rev-parse','--show-toplevel'],{stdio:['ignore','pipe','ignore']}).toString().trim()}catch{process.exit(0)}import(u.pathToFileURL(p.join(r,'.scripts','check-file-length.mjs')))\" -- --hook --turn-start"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".agents/skills/impeccable/scripts/impeccable\" ] || \".agents/skills/impeccable/scripts/impeccable\" hook",
            "commandWindows": "if exist \".agents/skills/impeccable/scripts/impeccable.cmd\" (\".agents/skills/impeccable/scripts/impeccable.cmd\" hook & exit /b)",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$r/.scripts/check-file-length.mjs\" ] || exit 0; node \"$r/.scripts/check-file-length.mjs\" --hook",
            "commandWindows": "node -e \"const c=require('child_process'),p=require('path'),u=require('url');let r;try{r=c.execFileSync('git',['rev-parse','--show-toplevel'],{stdio:['ignore','pipe','ignore']}).toString().trim()}catch{process.exit(0)}import(u.pathToFileURL(p.join(r,'.scripts','check-file-length.mjs')))\" -- --hook"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$r/.scripts/check-staging-effect.mjs\" ] || exit 0; node \"$r/.scripts/check-staging-effect.mjs\" --after",
            "commandWindows": "node -e \"const c=require('child_process'),p=require('path'),u=require('url');let r;try{r=c.execFileSync('git',['rev-parse','--show-toplevel'],{stdio:['ignore','pipe','ignore']}).toString().trim()}catch{process.exit(0)}import(u.pathToFileURL(p.join(r,'.scripts','check-staging-effect.mjs')))\" -- --after"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".agents/skills/impeccable/scripts/impeccable\" ] || \".agents/skills/impeccable/scripts/impeccable\" hook",
            "commandWindows": "if exist \".agents/skills/impeccable/scripts/impeccable.cmd\" (\".agents/skills/impeccable/scripts/impeccable.cmd\" hook & exit /b)",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$r/.scripts/check-file-length.mjs\" ] || exit 0; node \"$r/.scripts/check-file-length.mjs\" --hook",
            "commandWindows": "node -e \"const c=require('child_process'),p=require('path'),u=require('url');let r;try{r=c.execFileSync('git',['rev-parse','--show-toplevel'],{stdio:['ignore','pipe','ignore']}).toString().trim()}catch{process.exit(0)}import(u.pathToFileURL(p.join(r,'.scripts','check-file-length.mjs')))\" -- --hook"
          }
        ]
      }
    ]
  }
}
