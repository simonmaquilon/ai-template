# Line endings: LF on every system, except scripts that Windows runs natively
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Agent skills, vendored or template-authored, exempt from the source-file limit (see .readme/92-agent-hooks.md)
.agents/skills/** linguist-vendored
