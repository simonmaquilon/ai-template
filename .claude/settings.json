{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": ["*"],
      "allowLocalBinding": true
    }
  },
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(diskutil erase*)",
      "Bash(shutdown *)",
      "Bash(reboot*)",
      "Bash(launchctl *)",
      "Bash(chmod -R *)",
      "Bash(chown -R *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(gh workflow run*)",
      "Bash(gh secret *)",
      "Bash(npm publish*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-staging.mjs",
              "--hook"
            ],
            "statusMessage": "Checking explicit Git staging"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-staging-effect.mjs",
              "--before"
            ],
            "statusMessage": "Recording staging before command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-empty-dirs.mjs"
            ],
            "statusMessage": "Removing empty directories"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-doc-links.mjs"
            ],
            "statusMessage": "Checking documentation links"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-instructions.mjs"
            ],
            "statusMessage": "Checking instruction routing and format"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-symlinks.mjs"
            ],
            "statusMessage": "Checking tracked symbolic links"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/sync-stack.mjs",
              "--hook"
            ],
            "statusMessage": "Syncing STACK.md"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-file-length.mjs",
              "--hook",
              "--turn-start"
            ],
            "statusMessage": "Starting file-length tracking"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-file-length.mjs",
              "--hook"
            ],
            "statusMessage": "Checking edited file lengths"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-staging-effect.mjs",
              "--after"
            ],
            "statusMessage": "Checking staging after command"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-security.mjs"
            ],
            "statusMessage": "Checking security patterns"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/sync-stack.mjs",
              "--hook"
            ],
            "statusMessage": "Syncing STACK.md"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-staging-effect.mjs",
              "--after"
            ],
            "statusMessage": "Checking staging after failed command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-file-length.mjs",
              "--hook"
            ],
            "statusMessage": "Checking file lengths before finishing"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "outputStyle": "Concise",
  "viewMode": "focus",
  "tui": "fullscreen"
}
