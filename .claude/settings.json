  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-bulk-staging.mjs",
              "--hook"
            ],
            "statusMessage": "Checking explicit Git staging"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-destructive-push.mjs",
              "--hook"
            ],
            "statusMessage": "Checking destructive Git pushes"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-write-scope.mjs"
            ],
            "statusMessage": "Checking shell writes to temporary folders"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-write-scope.mjs"
            ],
            "statusMessage": "Checking where the file write lands"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-empty-dirs.mjs"
            ],
            "statusMessage": "Removing empty directories"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-doc-links.mjs"
            ],
            "statusMessage": "Checking documentation links"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-instructions.mjs"
            ],
            "statusMessage": "Checking instruction routing and format"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-symlinks.mjs"
            ],
            "statusMessage": "Checking tracked symbolic links"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/update-stack-doc.mjs",
              "--hook"
            ],
            "statusMessage": "Syncing .docs/stack.md"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-file-length.mjs",
              "--hook",
              "--turn-start"
            ],
            "statusMessage": "Starting file-length tracking"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/remind-instructions.mjs"
            ],
            "statusMessage": "Reminding instruction routing"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-bugs.mjs"
            ],
            "statusMessage": "Checking bug register"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-template-seal.mjs"
            ],
            "statusMessage": "Checking sealed template files"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-file-length.mjs",
              "--hook"
            ],
            "statusMessage": "Checking edited file lengths"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-security.mjs"
            ],
            "statusMessage": "Checking security patterns"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-markdown.mjs",
              "--hook"
            ],
            "statusMessage": "Checking Markdown structure"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/update-stack-doc.mjs",
              "--hook"
            ],
            "statusMessage": "Syncing .docs/stack.md"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-file-length.mjs",
              "--hook"
            ],
            "statusMessage": "Checking file lengths before finishing"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "model": "opus",
  "effortLevel": "xhigh",
  "outputStyle": "Concise",
  "viewMode": "focus",
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_PROJECT_DIR}/.scripts/status-line.mjs\"",
    "refreshInterval": 60
  },
  "idleCompaction": true
}
