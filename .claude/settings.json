    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(diskutil erase*)",
      "Bash(shutdown *)",
      "Bash(reboot*)",
      "Bash(launchctl *)",
      "Bash(chmod -R *)",
      "Bash(chown -R *)",
      "PowerShell(sudo *)",
      "PowerShell(su *)",
      "PowerShell(dd *)",
      "PowerShell(mkfs*)",
      "PowerShell(diskutil erase*)",
      "PowerShell(shutdown *)",
      "PowerShell(reboot*)",
      "PowerShell(launchctl *)",
      "PowerShell(chmod -R *)",
      "PowerShell(chown -R *)"
