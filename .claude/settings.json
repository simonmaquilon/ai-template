{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "node .scripts/run-checks.mjs*",
      "node .scripts/browser.mjs*",
      "gh repo view*",
      "gh repo list*",
      "gh pr view*",
      "gh pr list*",
      "gh pr diff*",
      "gh pr checks*",
      "gh run list*",
      "gh run view*",
      "gh run watch*",
      "gh workflow list*",
      "gh workflow view*",
      "gh issue view*",
      "gh issue list*",
      "gh release list*",
      "gh release view*",
      "gh release verify*"
    ],
    "network": {
      "allowedDomains": ["*"],
      "allowLocalBinding": true
    }
  },
  "permissions": {
    "allow": [
      "Bash(gh repo view*)",
      "Bash(gh repo list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh release verify*)",
      "PowerShell(gh repo view*)",
      "PowerShell(gh repo list*)",
      "PowerShell(gh pr view*)",
      "PowerShell(gh pr list*)",
      "PowerShell(gh pr diff*)",
      "PowerShell(gh pr checks*)",
      "PowerShell(gh run list*)",
      "PowerShell(gh run view*)",
      "PowerShell(gh run watch*)",
      "PowerShell(gh workflow list*)",
      "PowerShell(gh workflow view*)",
      "PowerShell(gh issue view*)",
      "PowerShell(gh issue list*)",
      "PowerShell(gh release list*)",
      "PowerShell(gh release view*)",
      "PowerShell(gh release verify*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(diskutil erase*)",
      "Bash(shutdown *)",
      "Bash(reboot*)",
      "Bash(launchctl *)",
      "Bash(chmod -R *)",
      "Bash(chown -R *)",
      "PowerShell(sudo *)",
      "PowerShell(su *)",
      "PowerShell(dd *)",
      "PowerShell(mkfs*)",
      "PowerShell(diskutil erase*)",
      "PowerShell(shutdown *)",
      "PowerShell(reboot*)",
      "PowerShell(launchctl *)",
      "PowerShell(chmod -R *)",
      "PowerShell(chown -R *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh release -*)",
      "Bash(gh release create*)",
      "Bash(gh release new*)",
      "Bash(gh release delete*)",
      "Bash(gh release edit*)",
      "Bash(gh release upload*)",
      "Bash(gh release download*)",
      "Bash(gh repo create*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo unarchive*)",
      "Bash(gh repo fork*)",
      "Bash(gh repo sync*)",
      "Bash(gh repo deploy-key*)",
      "Bash(gh repo autolink*)",
      "Bash(gh issue delete*)",
      "Bash(gh issue transfer*)",
      "Bash(gh run delete*)",
      "Bash(gh cache delete*)",
      "Bash(gh label delete*)",
      "Bash(gh gist delete*)",
      "Bash(gh variable delete*)",
      "Bash(gh * --web*)",
      "Bash(gh workflow run*)",
      "Bash(gh secret *)",
      "Bash(gh api *)",
      "Bash(gh -*)",
      "Bash(gh pr -*)",
      "Bash(gh issue -*)",
      "Bash(gh run -*)",
      "Bash(gh cache -*)",
      "Bash(gh label -*)",
      "Bash(gh workflow -*)",
      "Bash(gh variable -*)",
      "Bash(npm publish*)",
      "Bash(npm * publish*)",
      "PowerShell(git push *)",
      "PowerShell(git * push *)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh pr close*)",
      "PowerShell(gh release -*)",
      "PowerShell(gh release create*)",
      "PowerShell(gh release new*)",
      "PowerShell(gh release delete*)",
      "PowerShell(gh release edit*)",
      "PowerShell(gh release upload*)",
      "PowerShell(gh release download*)",
      "PowerShell(gh repo create*)",
      "PowerShell(gh repo delete*)",
      "PowerShell(gh repo edit*)",
      "PowerShell(gh repo rename*)",
      "PowerShell(gh repo archive*)",
      "PowerShell(gh repo unarchive*)",
      "PowerShell(gh repo fork*)",
      "PowerShell(gh repo sync*)",
      "PowerShell(gh repo deploy-key*)",
      "PowerShell(gh repo autolink*)",
      "PowerShell(gh issue delete*)",
      "PowerShell(gh issue transfer*)",
      "PowerShell(gh run delete*)",
      "PowerShell(gh cache delete*)",
      "PowerShell(gh label delete*)",
      "PowerShell(gh gist delete*)",
      "PowerShell(gh variable delete*)",
      "PowerShell(gh * --web*)",
      "PowerShell(gh workflow run*)",
      "PowerShell(gh secret *)",
      "PowerShell(gh api *)",
      "PowerShell(gh -*)",
      "PowerShell(gh pr -*)",
      "PowerShell(gh issue -*)",
      "PowerShell(gh run -*)",
      "PowerShell(gh cache -*)",
      "PowerShell(gh label -*)",
      "PowerShell(gh workflow -*)",
      "PowerShell(gh variable -*)",
      "PowerShell(npm publish*)",
      "PowerShell(npm * publish*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-bulk-staging.mjs",
              "--hook"
            ],
            "statusMessage": "Checking explicit Git staging"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-empty-dirs.mjs"
            ],
            "statusMessage": "Removing empty directories"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-doc-links.mjs"
            ],
            "statusMessage": "Checking documentation links"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-instructions.mjs"
            ],
            "statusMessage": "Checking instruction routing and format"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-symlinks.mjs"
            ],
            "statusMessage": "Checking tracked symbolic links"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/update-stack-doc.mjs",
              "--hook"
            ],
            "statusMessage": "Syncing .docs/stack.md"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-file-length.mjs",
              "--hook",
              "--turn-start"
            ],
            "statusMessage": "Starting file-length tracking"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/remind-instructions.mjs"
            ],
            "statusMessage": "Reminding instruction routing"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-file-length.mjs",
              "--hook"
            ],
            "statusMessage": "Checking edited file lengths"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-security.mjs"
            ],
            "statusMessage": "Checking security patterns"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-markdown.mjs",
              "--hook"
            ],
            "statusMessage": "Checking Markdown structure"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/update-stack-doc.mjs",
              "--hook"
            ],
            "statusMessage": "Syncing .docs/stack.md"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.scripts/check-file-length.mjs",
              "--hook"
            ],
            "statusMessage": "Checking file lengths before finishing"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "model": "opus",
  "effortLevel": "xhigh",
  "outputStyle": "Concise",
  "viewMode": "focus",
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_PROJECT_DIR}/.scripts/status-line.mjs\"",
    "refreshInterval": 60
  },
  "idleCompaction": true
}
