{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "node .scripts/run-checks.mjs*",
      "node .scripts/browser.mjs*",
      "gh repo view*",
      "gh repo list*",
      "gh pr view*",
      "gh pr list*",
      "gh pr diff*",
      "gh pr checks*",
      "gh run list*",
      "gh run view*",
      "gh run watch*",
      "gh workflow list*",
      "gh workflow view*",
      "gh issue view*",
      "gh issue list*",
      "gh release list*",
      "gh release view*",
      "gh release verify*"
    ],
    "network": {
      "allowedDomains": ["*"],
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyWrite": [".scripts", ".codex", ".agents/skills", ".temp/playwright-cli"]
    }
  },
  "permissions": {
    "allow": [
      "Bash(node .scripts/run-checks.mjs)",
      "Bash(node .scripts/run-checks.mjs *)",
      "Bash(gh repo view*)",
      "Bash(gh repo list*)",
      "Bash(gh pr view*)",
